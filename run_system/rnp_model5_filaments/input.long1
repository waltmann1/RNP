variable TEMP           equal   300.0
variable PRESS 		equal   0.0

#variable SEED  		equal  	999
variable SEED2   	equal   $( v_SEED + 1099 )
variable SEED3  	equal   $( v_SEED + 80192 ) 
variable SEED4  	equal   $( v_SEED + 7102 )
variable SEED5 		equal   $( v_SEED + 30192 )

include "system.init"
read_data "nuced_short_seed1246.data"
#read_restart "81.restart.20000000"
include "system.settings"


#comm_style tiled
comm_modify mode single cutoff 110.0

timestep  10.0 

neighbor 12.0 bin

#compute 1 all pair srlr_gauss

group int type 1:267

fix 1  int    nve
fix 2  int    langevin 0 ${TEMP} 100000.0 ${SEED3} zero yes
#fix b1 all balance 25000 1.05 rcb

thermo 5000 #500
#thermo_style  custom  step spcpu  temp  ke pe etotal  epair c_1 lx ly lz  pxx pyy pzz f_3[1] f_3[2] f_3[3] f_3[4] f_3[5] f_3[6] f_3[7]

dump 1 all atom 10000000 dump1.lammpstrj
dump_modify 1 sort id

restart 10000000 long1.restart

minimize 1e-4 1e-6 1000 1000

write_data eq.minimize.data


run 100000
unfix 2
fix 2  int   langevin ${TEMP} ${TEMP} 100000.0 ${SEED3} zero yes



label loopa
variable a loop 60
	fix 3 all cluster_switch 1246  0 20.0 ${SEED2} rateFreq 1 rateFile rates.txt contactFile contacts.txt 
	run 1
	unfix 3 
	run 499999
next a
jump input.long1 loopa



write_data eq.1.data

